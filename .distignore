# Files excluded from the WordPress.org SVN deployment / plugin ZIP.
# Any path listed here is kept in the GitHub repo but not pushed to SVN
# (compatible with wp-env, wp-scripts, and manual deploy scripts).
#
# Dev tooling — Composer, npm, PHPCS, PHPStan, PHPUnit, wp-env, ESLint —
# lives in dev/. It is excluded as a whole below; the belt-and-braces
# entries further down catch any stray copies of individual config files
# that might appear in the root.

# Developer / project documentation
CONTRIBUTING.md
COMPETITIVE-ANALYSIS.md
readme-wp.md
blog-post-draft.md
blog-post-redis.md
blog-ai-who-is-learning.md
blog-review-uniform.md
blog-knocking-on-the-door.md

# Belt-and-braces — internal docs that normally live in
# ../lingua-forge-audit/ but might drift back here by accident.
CLAUDE.md
REVIEW.md
AUDIT-*.md

# Git
.git
.gitignore
.gitattributes

# Editor and IDE
.editorconfig
.vscode/
.idea/
.DS_Store

# Dev tooling — all tooling lives here; never ships to .org.
dev/

# Tests — the suite lives in this folder (it's plugin source we want
# under version control), but we don't ship it to .org.
tests/
build/
coverage/

# Belt-and-braces — if anyone ever copies a dev-tooling config back
# into the plugin folder, the deploy ZIP must still exclude it.
node_modules/
package.json
package-lock.json
.eslintrc.json
.prettierrc.json
.stylelintrc.json
.wp-env.json
.wp-env.override.json
.wp-env/
composer.json
composer.lock
vendor/
phpcs.xml
phpcs.xml.dist
.phpcs.xml
.phpcs.cache
phpunit.xml
phpunit.xml.dist
.phpunit.result.cache
phpstan.neon
phpstan.neon.dist
.phpstan.cache
