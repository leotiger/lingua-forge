<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="../tests/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    convertDeprecationsToExceptions="true"
    failOnWarning="true"
    failOnRisky="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    beStrictAboutOutputDuringTests="true"
    cacheResult="true"
    cacheResultFile=".phpunit.result.cache"
    >
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">../tests/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">../tests/integration</directory>
        </testsuite>
        <testsuite name="integration:wc">
            <directory suffix="Test.php">../tests/integration/WooCommerce</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">../language-router/includes</directory>
            <directory suffix=".php">../ai/includes</directory>
            <directory suffix=".php">../meta-description</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>../tests</directory>
            <directory>node_modules</directory>
        </exclude>
        <report>
            <!--
                Default report dirs apply when running a single suite directly
                (e.g. composer test:unit). The composer coverage command overrides
                these via CLI flags and writes to coverage/unit/ or
                coverage/integration/ so suites never overwrite each other.
            -->
            <html outputDirectory="coverage/unit/html" lowUpperBound="50" highLowerBound="80"/>
            <text outputFile="coverage/unit/coverage.txt" showUncoveredFiles="false"/>
        </report>
    </coverage>

    <php>
        <!--
            Integration test environment. wp-env exposes WP_TESTS_DIR at
            /wordpress-phpunit inside its tests-cli container. The vars
            are picked up via getenv() in tests/bootstrap.php.
        -->
        <ini name="memory_limit" value="512M"/>
        <!--
            Suppress error_log() output during test runs. Several unit tests deliberately
            pass malformed AI responses (bad JSON, truncated envelopes, wrong block counts)
            to exercise error-path branches in parse_full_post_envelope() and
            parse_tm_envelope(). Those methods call error_log() for diagnostic purposes,
            which PHP routes to stdout in some environments, polluting test output with
            expected-but-noisy lines like "response was not valid JSON". Redirecting to
            /dev/null keeps the output clean without suppressing real PHP errors (those
            are captured by PHPUnit's own error handler independently of error_log).
        -->
        <ini name="error_log" value="/dev/null"/>
        <env name="WP_TESTS_DIR" value="/wordpress-phpunit" force="false"/>
        <env name="WP_PHPUNIT__DIR" value="/wordpress-phpunit" force="false"/>
        <env name="WP_TESTS_DOMAIN" value="example.org" force="false"/>
        <env name="WP_TESTS_EMAIL" value="admin@example.org" force="false"/>
        <env name="WP_TESTS_TITLE" value="Lingua Forge Tests" force="false"/>
    </php>
</phpunit>
