[zh_CN] "preset" -> "\u9884\u8bbe"
[zh_CN] "Recreating\u2026" -> "\u6b63\u5728\u91cd\u5efa\u2026"
[zh_CN] "\u2713 All templates recreated." -> "\u2713 \u6240\u6709\u6a21\u677f\u5df2\u91cd\u5efa\u3002"
[zh_CN] "Some templates could not be recreated." -> "\u4e00\u4e9b\u6a21\u677f\u65e0\u6cd5\u91cd\u5efa\u3002"
[zh_CN] "This overwrites this template with a fresh copy from the active theme, discarding any Site Editor customisations made to it. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6b64\u6a21\u677f\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "This overwrites every template with a fresh copy from the active theme, discarding any Site Editor customisations made to them. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6bcf\u4e2a\u6a21\u677f\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "\u2713 All parts recreated." -> "\u2713 \u6240\u6709\u90e8\u5206\u5df2\u91cd\u5efa\u3002"
[zh_CN] "Some parts could not be recreated." -> "\u4e00\u4e9b\u90e8\u5206\u65e0\u6cd5\u91cd\u5efa\u3002"
[zh_CN] "This overwrites this template part with a fresh copy from the active theme, discarding any Site Editor customisations made to it. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6b64\u6a21\u677f\u90e8\u5206\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "This overwrites every template part with a fresh copy from the active theme, discarding any Site Editor customisations made to them. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6bcf\u4e2a\u6a21\u677f\u90e8\u5206\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "Re-create all templates" -> "\u91cd\u65b0\u521b\u5efa\u6240\u6709\u6a21\u677f"
[zh_CN] "Re-create all parts" -> "\u91cd\u65b0\u521b\u5efa\u6240\u6709\u90e8\u5206"
[zh_CN] "This runs Re-create all templates, Re-create all parts, Translate all, Fix all parts, and Fix all links for every one of your {total} active languages, one language at a time. It overwrites existing templates and parts with fresh copies from the active theme (discarding Site Editor customisations) and re-translates content \u2014 none of this can be undone. Translate all makes real AI API calls for every template and part, which may take a while and may incur cost depending on your provider. Continue?" -> "\u8fd9\u5c06\u4e3a\u60a8\u6240\u6709\u7684 {total} \u79cd\u6d3b\u52a8\u8bed\u8a00\u9010\u4e00\u8fd0\u884c\u91cd\u5efa\u6240\u6709\u6a21\u677f\u3001\u91cd\u5efa\u6240\u6709\u90e8\u5206\u3001\u7ffb\u8bd1\u6240\u6709\u3001\u4fee\u590d\u6240\u6709\u90e8\u5206\u548c\u4fee\u590d\u6240\u6709\u94fe\u63a5\u3002\u5b83\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u73b0\u6709\u6a21\u677f\u548c\u90e8\u5206\uff08\u4e22\u5f03\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\uff09\uff0c\u5e76\u91cd\u65b0\u7ffb\u8bd1\u5185\u5bb9\u2014\u2014\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u6d88\u3002\u7ffb\u8bd1\u6240\u6709\u4f1a\u4e3a\u6bcf\u4e2a\u6a21\u677f\u548c\u90e8\u5206\u8fdb\u884c\u771f\u5b9e\u7684AI API\u8c03\u7528\uff0c\u53ef\u80fd\u9700\u8981\u4e00\u4e9b\u65f6\u95f4\uff0c\u5e76\u53ef\u80fd\u6839\u636e\u60a8\u7684\u63d0\u4f9b\u5546\u4ea7\u751f\u8d39\u7528\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "This runs Re-create all templates, Translate all, Fix all parts, and Fix all links for every one of your {total} active languages, one language at a time \u2014 template parts (headers, footers, etc.) are left untouched. It overwrites existing templates with fresh copies from the active theme (discarding Site Editor customisations) and re-translates content \u2014 none of this can be undone. Translate all makes real AI API calls for every template, which may take a while and may incur cost depending on your provider. Continue?" -> "\u8fd9\u5c06\u4e3a\u60a8\u6240\u6709\u7684 {total} \u79cd\u6d3b\u52a8\u8bed\u8a00\u9010\u4e00\u8fd0\u884c\u91cd\u5efa\u6240\u6709\u6a21\u677f\u3001\u7ffb\u8bd1\u6240\u6709\u3001\u4fee\u590d\u6240\u6709\u90e8\u5206\u548c\u4fee\u590d\u6240\u6709\u94fe\u63a5\u2014\u2014\u6a21\u677f\u90e8\u5206\uff08\u9875\u7709\u3001\u9875\u811a\u7b49\uff09\u4fdd\u6301\u4e0d\u53d8\u3002\u5b83\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u73b0\u6709\u6a21\u677f\uff08\u4e22\u5f03\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\uff09\u5e76\u91cd\u65b0\u7ffb\u8bd1\u5185\u5bb9\u2014\u2014\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u6d88\u3002\u7ffb\u8bd1\u6240\u6709\u4f1a\u4e3a\u6bcf\u4e2a\u6a21\u677f\u8fdb\u884c\u771f\u5b9e\u7684AI API\u8c03\u7528\uff0c\u53ef\u80fd\u9700\u8981\u4e00\u4e9b\u65f6\u95f4\uff0c\u5e76\u53ef\u80fd\u6839\u636e\u60a8\u7684\u63d0\u4f9b\u5546\u4ea7\u751f\u8d39\u7528\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "This runs Re-create all parts (headers, footers, and every other template part) for every one of your {total} active languages, one language at a time. It overwrites existing template parts with fresh copies from the active theme, discarding any Site Editor customisations made to them. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u4e3a\u60a8\u6240\u6709\u7684 {total} \u79cd\u6d3b\u52a8\u8bed\u8a00\u9010\u4e00\u8fd0\u884c\u91cd\u5efa\u6240\u6709\u90e8\u5206\uff08\u9875\u7709\u3001\u9875\u811a\u548c\u6bcf\u4e2a\u5176\u4ed6\u6a21\u677f\u90e8\u5206\uff09\u3002\u5b83\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u73b0\u6709\u6a21\u677f\u90e8\u5206\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "Starting\u2026" -> "\u5f00\u59cb\u2026"
[zh_CN] "Processing {lang} ({index} of {total}) \u2014 {step}\u2026" -> "\u6b63\u5728\u5904\u7406 {lang} ({index} \/ {total}) \u2014 {step}\u2026"
[zh_CN] "Cancelled." -> "\u5df2\u53d6\u6d88\u3002"
[zh_CN] "{done} of {total} languages processed." -> "\u5df2\u5904\u7406 {done} \/ {total} \u79cd\u8bed\u8a00\u3002"
[zh_CN] "\u26a0 Done with issues." -> "\u26a0 \u5b8c\u6210\uff0c\u4f46\u5b58\u5728\u95ee\u9898\u3002"
[zh_CN] "\u2713 All {total} languages processed." -> "\u2713 \u6240\u6709 {total} \u79cd\u8bed\u8a00\u5df2\u5904\u7406\u3002"
[zh_CN] "Trash + Siblings" -> "\u5783\u573e\u7bb1 + \u540c\u7c7b"
[zh_CN] "Move to Trash (incl. translations)" -> "\u79fb\u81f3\u5783\u573e\u7bb1\uff08\u5305\u62ec\u7ffb\u8bd1\uff09"
[zh_CN] plural slot 0: "Trashed %d post (including translations)." -> "\u5df2\u79fb\u81f3\u5783\u573e\u7bb1 %d \u7bc7\u6587\u7ae0\uff08\u5305\u62ec\u7ffb\u8bd1\uff09\u3002"
[zh_CN] plural slot 0: "%d post was skipped (no permission or protected)." -> "%d \u7bc7\u6587\u7ae0\u88ab\u8df3\u8fc7\uff08\u6ca1\u6709\u6743\u9650\u6216\u53d7\u4fdd\u62a4\uff09\u3002"
