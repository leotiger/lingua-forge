[ru_RU] plural slot 2: "Trashed %d post (including translations)." -> "\u0423\u0434\u0430\u043b\u0435\u043d\u044b \u0432 \u043a\u043e\u0440\u0437\u0438\u043d\u0443 %d \u0437\u0430\u043f\u0438\u0441\u0435\u0439 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u044b)."
[ru_RU] plural slot 0: "%d post was skipped (no permission or protected)." -> "\u041f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u0430 %d \u0437\u0430\u043f\u0438\u0441\u044c (\u043d\u0435\u0442 \u043f\u0440\u0430\u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0438\u043b\u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u0430)."
[ru_RU] plural slot 1: "%d post was skipped (no permission or protected)." -> "\u041f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u044b %d \u0437\u0430\u043f\u0438\u0441\u0438 (\u043d\u0435\u0442 \u043f\u0440\u0430\u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0438\u043b\u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u044b)."
[ru_RU] plural slot 2: "%d post was skipped (no permission or protected)." -> "\u041f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u044b %d \u0437\u0430\u043f\u0438\u0441\u0435\u0439 (\u043d\u0435\u0442 \u043f\u0440\u0430\u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u0438\u043b\u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u044b)."
