[ar] plural slot 4: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d \u0632\u0648\u062c \u0644\u0645 \u064a\u062a\u0645 \u062a\u0631\u062c\u0645\u062a\u0647 \u0628\u0639\u062f (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u0631\u062f \u0645\u062a\u062f\u0627\u062e\u0644 \u064a\u0646\u062a\u0638\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0635\u0644\u064a \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u060c \u0623\u0648 \u0644\u063a\u0629 \u062d\u0627\u0644\u064a\u0627\u064b \u0641\u064a \u0641\u062a\u0631\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0628\u0639\u062f \u0641\u0634\u0644\u0627\u062a \u0645\u062a\u0643\u0631\u0631\u0629)."
[ar] plural slot 5: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d \u0623\u0632\u0648\u0627\u062c \u0644\u0645 \u064a\u062a\u0645 \u062a\u0631\u062c\u0645\u062a\u0647\u0627 \u0628\u0639\u062f (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \u0631\u062f\u0648\u062f \u0645\u062a\u062f\u0627\u062e\u0644\u0629 \u062a\u0646\u062a\u0638\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0635\u0644 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647\u0627\u060c \u0623\u0648 \u0644\u063a\u0629 \u062d\u0627\u0644\u064a\u0627\u064b \u0641\u064a \u0641\u062a\u0631\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u0628\u0639\u062f \u0641\u0634\u0644\u0627\u062a \u0645\u062a\u0643\u0631\u0631\u0629)."
[ar] "Comment Translation" -> "\u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642"
[ar] "Mirrors an approved comment onto every language version of the post it belongs to, translated, as a real comment on each sibling page. Off by default." -> "\u064a\u0639\u0643\u0633 \u062a\u0639\u0644\u064a\u0642\u0627\u064b \u0645\u0639\u062a\u0645\u062f\u0627\u064b \u0625\u0644\u0649 \u0643\u0644 \u0646\u0633\u062e\u0629 \u0644\u063a\u0648\u064a\u0629 \u0645\u0646 \u0627\u0644\u0645\u0646\u0634\u0648\u0631 \u0627\u0644\u0630\u064a \u064a\u0646\u062a\u0645\u064a \u0625\u0644\u064a\u0647\u060c \u0645\u062a\u0631\u062c\u0645\u064b\u0627\u060c \u0643\u062a\u0639\u0644\u064a\u0642 \u062d\u0642\u064a\u0642\u064a \u0639\u0644\u0649 \u0643\u0644 \u0635\u0641\u062d\u0629 \u0634\u0642\u064a\u0642\u0629."
[ar] "Comment translation" -> "\u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642"
[ar] "Enable comment translation" -> "\u062a\u0641\u0639\u064a\u0644 \u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a"
[ar] "Off by default. This feature makes AI provider requests \u2014 and spends the associated API cost \u2014 for approved comments on any post that has translated language versions. WooCommerce product reviews are never included; they already share one review pool across languages." -> "\u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0628\u0634\u0643\u0644 \u0627\u0641\u062a\u0631\u0627\u0636\u064a. \u0647\u0630\u0647 \u0627\u0644\u0645\u064a\u0632\u0629 \u062a\u062c\u0639\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0639\u0644\u0649 \u0645\u0632\u0648\u062f \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0635\u0646\u0627\u0639\u064a - \u0648\u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629 - \u0644\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629 \u0639\u0644\u0649 \u0623\u064a \u0645\u0646\u0634\u0648\u0631 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0646\u0633\u062e \u0644\u063a\u0648\u064a\u0629 \u0645\u062a\u0631\u062c\u0645\u0629. \u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0645\u0646\u062a\u062c\u0627\u062a WooCommerce \u0644\u0627 \u062a\u062f\u0631\u062c \u0623\u0628\u062f\u0627\u064b\u061b \u0641\u0647\u064a \u062a\u0634\u0627\u0631\u0643 \u0628\u0627\u0644\u0641\u0639\u0644 \u0645\u062c\u0645\u0648\u0639\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0627\u0644\u062a\u0642\u064a\u064a\u0645\u0627\u062a \u0639\u0628\u0631 \u0627\u0644\u0644\u063a\u0627\u062a."
[ar] "Translation trigger" -> "\u0645\u062d\u0641\u0632 \u0627\u0644\u062a\u0631\u062c\u0645\u0629"
[ar] "Manual \u2014 translate only via the Comments screen action" -> "\u064a\u062f\u0648\u064a - \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0641\u0642\u0637 \u0639\u0628\u0631 \u0625\u062c\u0631\u0627\u0621 \u0634\u0627\u0634\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a"
[ar] "Automatic \u2014 translate every comment as soon as it's approved" -> "\u062a\u0644\u0642\u0627\u0626\u064a - \u062a\u0631\u062c\u0645\u0629 \u0643\u0644 \u062a\u0639\u0644\u064a\u0642 \u0628\u0645\u062c\u0631\u062f \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u064a\u0647"
[ar] "Manual (default) queues nothing automatically \u2014 use the \"Translate missing\" bulk action on the Comments screen on your own schedule. Automatic queues a translation the moment a comment is approved (or arrives already-approved), which can spend API calls on comments a moderator was about to reject if there's a large held-for-moderation backlog." -> "\u0627\u0644\u0635\u0641\u0648\u0641 \u0627\u0644\u064a\u062f\u0648\u064a\u0629 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a) \u0644\u0627 \u062a\u0642\u0648\u0645 \u0628\u062c\u062f\u0648\u0644\u0629 \u0623\u064a \u0634\u064a\u0621 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u2014 \u0627\u0633\u062a\u062e\u062f\u0645 \u0625\u062c\u0631\u0627\u0621 \"\u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0645\u0641\u0642\u0648\u062f\" \u0627\u0644\u062c\u0645\u0627\u0639\u064a \u0641\u064a \u0634\u0627\u0634\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u062d\u0633\u0628 \u062c\u062f\u0648\u0644\u0643 \u0627\u0644\u062e\u0627\u0635. \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u064a\u0642\u0648\u0645 \u0628\u062c\u062f\u0648\u0644\u0629 \u062a\u0631\u062c\u0645\u0629 \u0641\u064a \u0627\u0644\u0644\u062d\u0638\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0645 \u0641\u064a\u0647\u0627 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u062a\u0639\u0644\u064a\u0642 (\u0623\u0648 \u064a\u0635\u0644 \u0645\u0639\u062a\u0645\u062f\u064b\u0627 \u0628\u0627\u0644\u0641\u0639\u0644)\u060c \u0645\u0645\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0633\u062a\u0647\u0644\u0643 \u0645\u0643\u0627\u0644\u0645\u0627\u062a API \u0639\u0644\u0649 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u0643\u0627\u0646 \u0645\u0646 \u0627\u0644\u0645\u0645\u0643\u0646 \u0623\u0646 \u064a\u0631\u0641\u0636\u0647\u0627 \u0627\u0644\u0645\u0634\u0631\u0641 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0646\u0627\u0643 \u062a\u0631\u0627\u0643\u0645 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0631\u0627\u062c\u0639\u0629."
[ar] "Max nested-reply depth" -> "\u0623\u0642\u0635\u0649 \u0639\u0645\u0642 \u0644\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u062f\u0627\u062e\u0644\u0629"
[ar] "How many levels of nested replies \"Translate missing\" will walk and translate in one pass, counting the original top-level comment as level 0. Default 2 covers the original comment plus replies and replies-to-replies. Bounds AI spend on deep threads \u2014 anything nested deeper isn't backfilled until this is raised or a further pass runs." -> "\u0639\u062f\u062f \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0627\u0644\u0645\u062a\u062f\u0627\u062e\u0644\u0629 \u0627\u0644\u062a\u064a \u0633\u064a\u062a\u0645\u0643\u0646 \"\u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0645\u0641\u0642\u0648\u062f\" \u0645\u0646 \u0642\u0631\u0627\u0621\u062a\u0647\u0627 \u0648\u062a\u0631\u062c\u0645\u062a\u0647\u0627 \u0641\u064a \u0639\u0645\u0644\u064a\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0645\u0639 \u0627\u0639\u062a\u0628\u0627\u0631 \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u0635\u0644\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 0. \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a 2 \u064a\u063a\u0637\u064a \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u0635\u0644\u064a \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0631\u062f\u0648\u062f \u0648\u0627\u0644\u0631\u062f\u0648\u062f \u0639\u0644\u0649 \u0627\u0644\u0631\u062f\u0648\u062f. \u064a\u062d\u062f\u062f \u0625\u0646\u0641\u0627\u0642 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0627\u0642\u0634\u0627\u062a \u0627\u0644\u0639\u0645\u064a\u0642\u0629 \u2014 \u0623\u064a \u0634\u064a\u0621 \u0639\u0645\u064a\u0642 \u0623\u0643\u062b\u0631 \u0644\u0646 \u064a\u064f\u0639\u0627\u0644\u062c \u062d\u062a\u0649 \u064a\u062a\u0645 \u0631\u0641\u0639 \u0647\u0630\u0627 \u0627\u0644\u0631\u0642\u0645 \u0623\u0648 \u062a\u0634\u063a\u064a\u0644 \u0639\u0645\u0644\u064a\u0629 \u0625\u0636\u0627\u0641\u064a\u0629."
[ar] "Lang" -> "\u0627\u0644\u0644\u063a\u0629"
[ar] "Also mirrored to: %s" -> "\u0623\u064a\u0636\u064b\u0627 \u0645\u0643\u0631\u0631\u0629 \u0644\u0640: %s"
[ar] "Filter by language" -> "\u062a\u0635\u0641\u064a\u0629 \u062d\u0633\u0628 \u0627\u0644\u0644\u063a\u0629"
[ar] "All languages" -> "\u062c\u0645\u064a\u0639 \u0627\u0644\u0644\u063a\u0627\u062a"
[ca] plural slot 0: "%d comment translation created." -> "%d traducci\u00f3 de comentari creada."
[ca] plural slot 1: "%d comment translation created." -> "%d traduccions de comentari creades."
[ca] plural slot 0: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d parell no s'ha pogut traduir encara (per exemple, una resposta anidada que espera el seu pare, o un idioma actualment en per\u00edode de reflexi\u00f3 despr\u00e9s de fracassos repetits)."
[ca] plural slot 1: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d parells no s'han pogut traduir encara (per exemple, respostes anidades que esperen el seu pare, o un idioma actualment en per\u00edode de reflexi\u00f3 despr\u00e9s de fracassos repetits)."
[ca] "Comment Translation" -> "Traducci\u00f3 de comentari"
[ca] "Mirrors an approved comment onto every language version of the post it belongs to, translated, as a real comment on each sibling page. Off by default." -> "Reflecteix un comentari aprovat en cada versi\u00f3 ling\u00fc\u00edstica de la publicaci\u00f3 a la qual pertany, tradu\u00efda, com a un comentari real a cada p\u00e0gina germana. Apagat per defecte."
[ca] "Comment translation" -> "traducci\u00f3 de comentari"
[ca] "Enable comment translation" -> "Habilitar la traducci\u00f3 de comentaris"
[ca] "Off by default. This feature makes AI provider requests \u2014 and spends the associated API cost \u2014 for approved comments on any post that has translated language versions. WooCommerce product reviews are never included; they already share one review pool across languages." -> "Apagat per defecte. Aquesta funci\u00f3 fa sol\u00b7licituds al prove\u00efdor d\u2019IA \u2014 i gasta el cost d'API associat \u2014 per a comentaris aprovats en qualsevol publicaci\u00f3 que tingui versions idiom\u00e0tiques tradu\u00efdes. Les ressenyes de productes de WooCommerce no s'inclouen; ja comparteixen un \u00fanic grup de ressenyes entre idiomes."
[ca] "Translation trigger" -> "Gatell de traducci\u00f3"
[ca] "Manual \u2014 translate only via the Comments screen action" -> "Manual \u2014 traduir nom\u00e9s a trav\u00e9s de l'acci\u00f3 de la pantalla de comentaris"
[ca] "Automatic \u2014 translate every comment as soon as it's approved" -> "Autom\u00e0tic \u2014 traduir cada comentari tan aviat com sigui aprovat"
[ca] "Manual (default) queues nothing automatically \u2014 use the \"Translate missing\" bulk action on the Comments screen on your own schedule. Automatic queues a translation the moment a comment is approved (or arrives already-approved), which can spend API calls on comments a moderator was about to reject if there's a large held-for-moderation backlog." -> "Manual (per defecte) no posa res en cua autom\u00e0ticament \u2014 utilitzeu l'acci\u00f3 massiva \"Traduir mancants\" a la pantalla de comentaris al vostre propi horari. Autom\u00e0tic posa en cua una traducci\u00f3 en el moment que un comentari \u00e9s aprovat (o arriba ja aprovat), cosa que pot gastar crides d'API en comentaris que un moderador estava a punt de rebutjar si hi ha un gran retard en moderaci\u00f3."
[ca] "Max nested-reply depth" -> "M\u00e0x. profunditat de resposta anidada"
[ca] "How many levels of nested replies \"Translate missing\" will walk and translate in one pass, counting the original top-level comment as level 0. Default 2 covers the original comment plus replies and replies-to-replies. Bounds AI spend on deep threads \u2014 anything nested deeper isn't backfilled until this is raised or a further pass runs." -> "Quants nivells de respostes anidades \"Traduir mancants\" caminar\u00e0 i traduir\u00e0 en una sola passada, comptant el comentari original de nivell superior com nivell 0. El valor per defecte de 2 cobreix el comentari original m\u00e9s les respostes i les respostes a les respostes. Limita la despesa d'IA en fils profunds \u2014 qualsevol cosa anidada m\u00e9s profundament no s'omplir\u00e0 fins que aix\u00f2 es raise o es realitzi una passada addicional."
[ca] "Lang" -> "Idiomes"
[ca] "Also mirrored to: %s" -> "Tamb\u00e9 reflectit a: %s"
[ca] "Filter by language" -> "Filtrar per idioma"
[ca] "All languages" -> "Tots els idiomes"
[de_DE] plural slot 0: "%d comment translation created." -> "%d Kommentar\u00fcbersetzung erstellt."
[de_DE] plural slot 1: "%d comment translation created." -> "%d Kommentar\u00fcbersetzungen erstellt."
[de_DE] plural slot 0: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d Paare konnten noch nicht \u00fcbersetzt werden (z. B. eine geschachtelte Antwort, die auf ihr \u00fcbergeordnetes Element wartet, oder eine Sprache, die nach wiederholten Fehlern derzeit abgek\u00fchlt ist)."
[de_DE] plural slot 1: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d Paare konnten noch nicht \u00fcbersetzt werden (z. B. geschachtelte Antworten, die auf ihr \u00fcbergeordnetes Element warten, oder eine Sprache, die nach wiederholten Fehlern derzeit abgek\u00fchlt ist)."
[de_DE] "Comment Translation" -> "Kommentar\u00fcbersetzung"
[de_DE] "Mirrors an approved comment onto every language version of the post it belongs to, translated, as a real comment on each sibling page. Off by default." -> "Spiegelt einen genehmigten Kommentar auf jede Sprachversion des zugeh\u00f6rigen Beitrags, \u00fcbersetzt, als echter Kommentar auf jeder Geschwisterseite. Standardm\u00e4\u00dfig deaktiviert."
[de_DE] "Comment translation" -> "Kommentar\u00fcbersetzung"
[de_DE] "Enable comment translation" -> "Kommentar\u00fcbersetzung aktivieren"
[de_DE] "Off by default. This feature makes AI provider requests \u2014 and spends the associated API cost \u2014 for approved comments on any post that has translated language versions. WooCommerce product reviews are never included; they already share one review pool across languages." -> "Standardm\u00e4\u00dfig deaktiviert. Diese Funktion f\u00fchrt Anfragen an den KI-Anbieter durch \u2013 und verursacht die damit verbundenen API-Kosten \u2013 f\u00fcr genehmigte Kommentare zu jedem Beitrag, der \u00fcbersetzte Sprachversionen hat. WooCommerce-Produktbewertungen sind niemals eingeschlossen; sie teilen bereits einen Bewertungspool \u00fcber die Sprachen hinweg."
[de_DE] "Translation trigger" -> "\u00dcbersetzungs-Trigger"
[de_DE] "Manual \u2014 translate only via the Comments screen action" -> "Manuell \u2013 nur \u00fcber die Aktion auf dem Bildschirm Kommentare \u00fcbersetzen"
[de_DE] "Automatic \u2014 translate every comment as soon as it's approved" -> "Automatisch \u2013 jeden Kommentar direkt nach seiner Genehmigung \u00fcbersetzen"
[de_DE] "Manual (default) queues nothing automatically \u2014 use the \"Translate missing\" bulk action on the Comments screen on your own schedule. Automatic queues a translation the moment a comment is approved (or arrives already-approved), which can spend API calls on comments a moderator was about to reject if there's a large held-for-moderation backlog." -> "Manuell (Standard) stellt nichts automatisch in Warteschlange \u2013 verwenden Sie die Bulk-Aktion \"Fehlende \u00fcbersetzen\" auf dem Bildschirm Kommentare nach Ihrem eigenen Zeitplan. Automatisch stellt eine \u00dcbersetzung in Warteschlange, sobald ein Kommentar genehmigt wird (oder bereits genehmigt ankommt), was API-Aufrufe f\u00fcr Kommentare kosten kann, die ein Moderator gerade ablehnen wollte, wenn es einen gro\u00dfen R\u00fcckstand an moderierten Kommentaren gibt."
[de_DE] "Max nested-reply depth" -> "Maximale Tiefe der geschachtelten Antworten"
[de_DE] "How many levels of nested replies \"Translate missing\" will walk and translate in one pass, counting the original top-level comment as level 0. Default 2 covers the original comment plus replies and replies-to-replies. Bounds AI spend on deep threads \u2014 anything nested deeper isn't backfilled until this is raised or a further pass runs." -> "Wie viele Ebenen geschachtelter Antworten \"Fehlende \u00fcbersetzen\" in einem Durchgang durchlaufen und \u00fcbersetzen wird, wobei der urspr\u00fcngliche oberste Kommentar als Ebene 0 z\u00e4hlt. Standardwert 2 deckt den urspr\u00fcnglichen Kommentar sowie Antworten und Antworten auf Antworten ab. Begrenzt die Ausgaben der KI bei tiefen Threads \u2013 alles, was tiefer geschachtelt ist, wird nicht aufgef\u00fcllt, bis dies erh\u00f6ht wird oder ein weiterer Durchgang durchgef\u00fchrt wird."
[de_DE] "Lang" -> "Sprache"
[de_DE] "Also mirrored to: %s" -> "Auch gespiegelt nach: %s"
[de_DE] "Filter by language" -> "Nach Sprache filtern"
[de_DE] "All languages" -> "Alle Sprachen"
[el] plural slot 0: "%d comment translation created." -> "%d \u03bc\u03b5\u03c4\u03ac\u03c6\u03c1\u03b1\u03c3\u03b7 \u03c3\u03c7\u03cc\u03bb\u03b9\u03bf\u03c5 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5."
