[zh_CN] "This overwrites this template with a fresh copy from the active theme, discarding any Site Editor customisations made to it. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6b64\u6a21\u677f\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
[zh_CN] "This overwrites every template with a fresh copy from the active theme, discarding any Site Editor customisations made to them. This cannot be undone. Continue?" -> "\u8fd9\u5c06\u7528\u6d3b\u52a8\u4e3b\u9898\u4e2d\u7684\u65b0\u526f\u672c\u8986\u76d6\u6bcf\u4e2a\u6a21\u677f\uff0c\u4e22\u5f03\u5bf9\u5176\u6240\u505a\u7684\u4efb\u4f55\u7ad9\u70b9\u7f16\u8f91\u5668\u81ea\u5b9a\u4e49\u3002\u8fd9\u65e0\u6cd5\u64a4\u6d88\u3002\u7ee7\u7eed\u5417\uff1f"
