[ja] plural slot 0: "%d comment translation created." -> "%d \u4ef6\u306e\u30b3\u30e1\u30f3\u30c8\u7ffb\u8a33\u304c\u4f5c\u6210\u3055\u308c\u307e\u3057\u305f\u3002"
[ja] plural slot 0: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d \u4ef6\u306e\u30da\u30a2\u306f\u307e\u3060\u7ffb\u8a33\u3055\u308c\u3066\u3044\u307e\u305b\u3093\uff08\u4f8b\u3048\u3070\u3001\u89aa\u3092\u5f85\u3064\u30cd\u30b9\u30c8\u3055\u308c\u305f\u8fd4\u4fe1\u3084\u3001\u7e70\u308a\u8fd4\u3057\u5931\u6557\u3057\u305f\u5f8c\u306b\u30af\u30fc\u30eb\u30c0\u30a6\u30f3\u4e2d\u306e\u8a00\u8a9e\u306a\u3069\uff09\u3002"
[ja] "Comment Translation" -> "\u30b3\u30e1\u30f3\u30c8\u7ffb\u8a33"
[ja] "Mirrors an approved comment onto every language version of the post it belongs to, translated, as a real comment on each sibling page. Off by default." -> "\u627f\u8a8d\u3055\u308c\u305f\u30b3\u30e1\u30f3\u30c8\u3092\u3001\u5bfe\u5fdc\u3059\u308b\u6295\u7a3f\u306e\u3059\u3079\u3066\u306e\u8a00\u8a9e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u30ea\u30a2\u30eb\u30b3\u30e1\u30f3\u30c8\u3068\u3057\u3066\u7ffb\u8a33\u3057\u3066\u30df\u30e9\u30fc\u3057\u307e\u3059\u3002\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u306f\u30aa\u30d5\u3067\u3059\u3002"
[ja] "Comment translation" -> "\u30b3\u30e1\u30f3\u30c8\u7ffb\u8a33"
[ja] "Enable comment translation" -> "\u30b3\u30e1\u30f3\u30c8\u7ffb\u8a33\u3092\u6709\u52b9\u306b\u3059\u308b"
[ja] "Off by default. This feature makes AI provider requests \u2014 and spends the associated API cost \u2014 for approved comments on any post that has translated language versions. WooCommerce product reviews are never included; they already share one review pool across languages." -> "\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u306f\u30aa\u30d5\u3067\u3059\u3002\u3053\u306e\u6a5f\u80fd\u306f\u3001\u7ffb\u8a33\u3055\u308c\u305f\u8a00\u8a9e\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u3042\u308b\u3059\u3079\u3066\u306e\u6295\u7a3f\u306e\u627f\u8a8d\u6e08\u307f\u30b3\u30e1\u30f3\u30c8\u306b\u5bfe\u3057\u3066AI\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u884c\u3044\u3001\u95a2\u9023\u3059\u308bAPI\u30b3\u30b9\u30c8\u3092\u6d88\u8cbb\u3057\u307e\u3059\u3002WooCommerce\u306e\u88fd\u54c1\u30ec\u30d3\u30e5\u30fc\u306f\u542b\u307e\u308c\u307e\u305b\u3093; \u305d\u308c\u3089\u306f\u3059\u3067\u306b\u8a00\u8a9e\u3092\u8d85\u3048\u305f1\u3064\u306e\u30ec\u30d3\u30e5\u30fc\u306e\u30d7\u30fc\u30eb\u3092\u5171\u6709\u3057\u307e\u3059\u3002"
[ja] "Translation trigger" -> "\u7ffb\u8a33\u30c8\u30ea\u30ac\u30fc"
[ja] "Manual \u2014 translate only via the Comments screen action" -> "\u624b\u52d5 \u2014 \u30b3\u30e1\u30f3\u30c8\u753b\u9762\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u4ecb\u3057\u3066\u306e\u307f\u7ffb\u8a33\u3057\u307e\u3059"
[ja] "Automatic \u2014 translate every comment as soon as it's approved" -> "\u81ea\u52d5 \u2014 \u30b3\u30e1\u30f3\u30c8\u304c\u627f\u8a8d\u3055\u308c\u6b21\u7b2c\u3001\u3059\u3079\u3066\u306e\u30b3\u30e1\u30f3\u30c8\u3092\u7ffb\u8a33\u3057\u307e\u3059"
[ja] "Manual (default) queues nothing automatically \u2014 use the \"Translate missing\" bulk action on the Comments screen on your own schedule. Automatic queues a translation the moment a comment is approved (or arrives already-approved), which can spend API calls on comments a moderator was about to reject if there's a large held-for-moderation backlog." -> "\u624b\u52d5\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\uff09\u3067\u306f\u81ea\u52d5\u7684\u306b\u4f55\u3082\u30ad\u30e5\u30fc\u306b\u5165\u308c\u307e\u305b\u3093 \u2014 \u30b3\u30e1\u30f3\u30c8\u753b\u9762\u3067\u300c\u7ffb\u8a33\u304c\u5fc5\u8981\u306a\u3082\u306e\u3092\u7ffb\u8a33\u300d\u30d0\u30eb\u30af\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u81ea\u5206\u306e\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3067\u4f7f\u7528\u3057\u307e\u3059\u3002\u81ea\u52d5\u5316\u306f\u3001\u30b3\u30e1\u30f3\u30c8\u304c\u627f\u8a8d\u3055\u308c\u305f\u77ac\u9593\uff08\u307e\u305f\u306f\u65e2\u306b\u627f\u8a8d\u3055\u308c\u3066\u3044\u308b\u5834\u5408\uff09\u306b\u7ffb\u8a33\u3092\u30ad\u30e5\u30fc\u306b\u5165\u308c\u307e\u3059\u3002\u3053\u308c\u306f\u3001\u30e2\u30c7\u30ec\u30fc\u30bf\u30fc\u304c\u5374\u4e0b\u3057\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u30b3\u30e1\u30f3\u30c8\u306bAPI\u547c\u3073\u51fa\u3057\u3092\u6d88\u8cbb\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u3001\u30e2\u30c7\u30ec\u30fc\u30b7\u30e7\u30f3\u306e\u4fdd\u7559\u4e2d\u306e\u5927\u898f\u6a21\u306a\u30d0\u30c3\u30af\u30ed\u30b0\u304c\u3042\u308b\u5834\u5408\u3067\u3059\u3002"
[ja] "Max nested-reply depth" -> "\u6700\u5927\u30cd\u30b9\u30c8\u8fd4\u4fe1\u6df1\u5ea6"
[ja] "How many levels of nested replies \"Translate missing\" will walk and translate in one pass, counting the original top-level comment as level 0. Default 2 covers the original comment plus replies and replies-to-replies. Bounds AI spend on deep threads \u2014 anything nested deeper isn't backfilled until this is raised or a further pass runs." -> "\"\u7ffb\u8a33\u304c\u5fc5\u8981\u306a\u3082\u306e\u3092\u7ffb\u8a33\"\u304c\u4e00\u5ea6\u306e\u30d1\u30b9\u3067\u7ffb\u8a33\u3057\u3001\u3069\u306e\u30ec\u30d9\u30eb\u306e\u30cd\u30b9\u30c8\u3055\u308c\u305f\u8fd4\u4fe1\u307e\u3067\u6b69\u304f\u304b\u3001\u5143\u306e\u30c8\u30c3\u30d7\u30ec\u30d9\u30eb\u30b3\u30e1\u30f3\u30c8\u3092\u30ec\u30d9\u30eb0\u3068\u3057\u3066\u6570\u3048\u307e\u3059\u3002\u30c7\u30d5\u30a9\u30eb\u30c8\u306e2\u306f\u3001\u5143\u306e\u30b3\u30e1\u30f3\u30c8\u3068\u8fd4\u4fe1\u304a\u3088\u3073\u305d\u306e\u8fd4\u4fe1\u3092\u30ab\u30d0\u30fc\u3057\u307e\u3059\u3002\u6df1\u3044\u30b9\u30ec\u30c3\u30c9\u306b\u304a\u3051\u308bAI\u652f\u51fa\u306e\u5236\u9650 \u2014 \u3088\u308a\u6df1\u304f\u30cd\u30b9\u30c8\u3055\u308c\u305f\u3082\u306e\u306f\u3001\u3053\u308c\u304c\u5f15\u304d\u4e0a\u3052\u3089\u308c\u308b\u304b\u3001\u3055\u3089\u306b\u30d1\u30b9\u304c\u5b9f\u884c\u3055\u308c\u308b\u307e\u3067\u30d0\u30c3\u30af\u30d5\u30a3\u30eb\u3055\u308c\u307e\u305b\u3093\u3002"
