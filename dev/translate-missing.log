[ko_KR] plural slot 0: "%d comment translation created." -> "%d \ub313\uae00 \ubc88\uc5ed\uc774 \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
[ko_KR] plural slot 0: "%d pair could not be translated yet (e.g. a nested reply waiting on its parent, or a language currently in cooldown after repeated failures)." -> "%d \uc30d\uc758 \ub313\uae00\/\uc5b8\uc5b4\uac00 \uc544\uc9c1 \ubc88\uc5ed\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4 (\uc608: \ubd80\ubaa8\uc758 \uc751\ub2f5\uc744 \uae30\ub2e4\ub9ac\ub294 \uc911\ucca9\ub41c \uc751\ub2f5 \ub610\ub294 \uc5f0\uc18d \uc2e4\ud328\ub85c \uc778\ud574 \ud604\uc7ac \ucfe8\ub2e4\uc6b4 \uc911\uc778 \uc5b8\uc5b4)."
[ko_KR] "Comment Translation" -> "\ub313\uae00 \ubc88\uc5ed"
[ko_KR] "Mirrors an approved comment onto every language version of the post it belongs to, translated, as a real comment on each sibling page. Off by default." -> "\uc2b9\uc778\ub41c \ub313\uae00\uc744 \ud574\ub2f9 \uac8c\uc2dc\ubb3c\uc758 \ubaa8\ub4e0 \uc5b8\uc5b4 \ubc84\uc804\uc73c\ub85c \uac70\uc6b8\ucc98\ub7fc \ubc18\uc601\ud558\uba70, \uac01 \ud615\uc81c \ud398\uc774\uc9c0\uc5d0 \ub300\ud55c \uc2e4\uc81c \ub313\uae00\ub85c \ubc88\uc5ed\ub429\ub2c8\ub2e4. \uae30\ubcf8\uac12\uc740 \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4."
[ko_KR] "Comment translation" -> "\ub313\uae00 \ubc88\uc5ed"
[ko_KR] "Enable comment translation" -> "\ub313\uae00 \ubc88\uc5ed \ud65c\uc131\ud654"
[ko_KR] "Off by default. This feature makes AI provider requests \u2014 and spends the associated API cost \u2014 for approved comments on any post that has translated language versions. WooCommerce product reviews are never included; they already share one review pool across languages." -> "\uae30\ubcf8\uac12\uc740 \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uae30\ub2a5\uc740 \uc2b9\uc778\ub41c \ub313\uae00\uc5d0 \ub300\ud574 AI \uc81c\uacf5\uc790 \uc694\uccad\uc744 \uc0dd\uc131\ud558\uba70 \uad00\ub828 API \ube44\uc6a9\uc744 \uc18c\ubaa8\ud569\ub2c8\ub2e4. WooCommerce \uc0c1\ud488 \ub9ac\ubdf0\ub294 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc73c\uba70, \uc774\ubbf8 \uc5b8\uc5b4\ubcc4\ub85c \ud558\ub098\uc758 \ub9ac\ubdf0 \ud480\uc744 \uacf5\uc720\ud569\ub2c8\ub2e4."
[ko_KR] "Translation trigger" -> "\ubc88\uc5ed \ud2b8\ub9ac\uac70"
[ko_KR] "Manual \u2014 translate only via the Comments screen action" -> "\uc218\ub3d9 \u2014 \ub313\uae00 \ud654\uba74 \uc791\uc5c5\uc744 \ud1b5\ud574\uc11c\ub9cc \ubc88\uc5ed"
[ko_KR] "Automatic \u2014 translate every comment as soon as it's approved" -> "\uc790\ub3d9 \u2014 \ub313\uae00\uc774 \uc2b9\uc778\ub418\ub294 \uc989\uc2dc \ubaa8\ub4e0 \ub313\uae00\uc744 \ubc88\uc5ed"
[ko_KR] "Manual (default) queues nothing automatically \u2014 use the \"Translate missing\" bulk action on the Comments screen on your own schedule. Automatic queues a translation the moment a comment is approved (or arrives already-approved), which can spend API calls on comments a moderator was about to reject if there's a large held-for-moderation backlog." -> "\uc218\ub3d9(\uae30\ubcf8\uac12)\uc740 \uc790\ub3d9\uc73c\ub85c \uc544\ubb34\uac83\ub3c4 \ub300\uae30\uc5f4\uc5d0 \ucd94\uac00\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4 \u2014 \ub313\uae00 \ud654\uba74\uc5d0\uc11c \"\ubc88\uc5ed \ub204\ub77d\" \ub300\ub7c9 \uc791\uc5c5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ubcf8\uc778\uc758 \uc77c\uc815\uc5d0 \ub9de\uac8c \uc9c4\ud589\ud569\ub2c8\ub2e4. \uc790\ub3d9 \ubaa8\ub4dc\ub294 \ub313\uae00\uc774 \uc2b9\uc778\ub418\uac70\ub098 \uc774\ubbf8 \uc2b9\uc778\ub41c \uc0c1\ud0dc\ub85c \ub3c4\ucc29\ud558\uba74 \uc989\uc2dc \ubc88\uc5ed\uc744 \ub300\uae30\uc5f4\uc5d0 \ucd94\uac00\ud558\uba70, \uc774\ub294 \ub300\uae30 \uc911\uc778 \ubaa8\ub354\ub808\uc774\ud130\uac00 \uac70\ubd80\ud558\ub824\uace0 \ud588\ub358 \ub313\uae00\uc5d0 \ub300\ud574 API \ud638\ucd9c\uc744 \uc18c\ubaa8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
[ko_KR] "Max nested-reply depth" -> "\ucd5c\ub300 \uc911\ucca9 \uc751\ub2f5 \uae4a\uc774"
[ko_KR] "How many levels of nested replies \"Translate missing\" will walk and translate in one pass, counting the original top-level comment as level 0. Default 2 covers the original comment plus replies and replies-to-replies. Bounds AI spend on deep threads \u2014 anything nested deeper isn't backfilled until this is raised or a further pass runs." -> "\"\ubc88\uc5ed \ub204\ub77d\"\uc774 \ud55c \ubc88\uc758 \ud328\uc2a4\ub85c \ucc98\ub9ac\ud558\uc5ec \ubc88\uc5ed\ud560 \uc911\ucca9\ub41c \uc751\ub2f5\uc758 \ub808\ubca8 \uc218, \uc6d0\ub798 \ucd5c\uc0c1\uc704 \ub313\uae00\uc744 \ub808\ubca8 0\uc73c\ub85c \uacc4\uc0b0\ud569\ub2c8\ub2e4. \uae30\ubcf8\uac12 2\ub294 \uc6d0\ub798 \ub313\uae00\uacfc \uadf8\uc5d0 \ub300\ud55c \uc751\ub2f5 \ubc0f \uc751\ub2f5\uc758 \uc751\ub2f5\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4. \uae4a\uc740 \uc2a4\ub808\ub4dc\uc5d0 \ub300\ud55c AI \ube44\uc6a9\uc744 \uc81c\ud55c\ud569\ub2c8\ub2e4 \u2014 \uc774 \uac12\uc774 \ub192\uc544\uc9c0\uac70\ub098 \ucd94\uac00 \ud328\uc2a4\uac00 \uc2e4\ud589\ub420 \ub54c\uae4c\uc9c0 \ub354 \uae4a\uc774 \uc911\ucca9\ub41c \uac83\uc740 \ubcf4\ucda9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
[ko_KR] "Lang" -> "\uc5b8\uc5b4"
[ko_KR] "Also mirrored to: %s" -> "\ub610\ud55c \ub2e4\uc74c\uc5d0 \ubc18\uc601\ub428: %s"
[ko_KR] "Filter by language" -> "\uc5b8\uc5b4\ubcc4 \ud544\ud130"
