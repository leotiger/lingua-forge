[ja] "Also mirrored to: %s" -> "\u6b21\u306e\u8a00\u8a9e\u306b\u3082\u30df\u30e9\u30fc\u3055\u308c\u3066\u3044\u307e\u3059: %s"
[ja] "Filter by language" -> "\u8a00\u8a9e\u3067\u30d5\u30a3\u30eb\u30bf\u30ea\u30f3\u30b0"
