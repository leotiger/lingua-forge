{
    "core": "WordPress/WordPress#6.9",
    "phpVersion": "8.1",
    "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": true,
        "WP_ENVIRONMENT_TYPE": "local",
        "WP_MEMORY_LIMIT": "512M"
    },
    "mappings": {
        "wp-content/plugins/lingua-forge": "..",
        "dev-tools": ".",
        "tests": "../tests"
    },
    "env": {
        "development": {
            "mappings": {
                "wp-content/mu-plugins": "./mu-plugins"
            }
        },
        "tests": {
            "config": {
                "WP_DEBUG": true,
                "SCRIPT_DEBUG": true
            }
        }
    }
}
