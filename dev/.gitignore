# Generated by Composer — never commit.
vendor/
composer.lock

# Generated by npm — never commit.
node_modules/
package-lock.json

# Tool caches.
.phpcs.cache
.phpunit.result.cache
.phpstan.cache

# Coverage output — reproducible, and embeds this machine's own absolute
# filesystem paths; never commit (same reasoning applied in the agnosis
# sibling repo, AUDIT-0.9.39.md §6 / H-1).
coverage/
coverage-*.xml
coverage-*.cov

# wp-env runtime data.
.wp-env/
.wp-env.override.json

# WP-CLI phar — downloaded on demand by bin/make-pot.sh, not committed.
wp-cli.phar

# Playwright — stored auth session and test artefacts.
e2e/.auth/
test-results/
playwright-report/
