.github/                    export-ignore

# Editor and IDE
.editorconfig               export-ignore
.vscode/                    export-ignore
.idea/                      export-ignore

# Dev tooling
dev/                        export-ignore

# Tests
tests/                      export-ignore
build/                      export-ignore
coverage/                   export-ignore
