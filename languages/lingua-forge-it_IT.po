#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Routing multilingue, SEO multilingue completo (hreflang, Open Graph, Schema."
"org, sitemap), e strumenti di contenuto AI per WordPress. Rilevamento della "
"lingua, routing URL, traduzione, generazione di contenuti e un livello SEO "
"completo — nessun plugin companion richiesto."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

