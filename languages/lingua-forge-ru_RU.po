#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "Лингва Фордж"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"Многоязычная маршрутизация, SEO метатеги и инструменты ИИ для контента для "
"WordPress. Объединяет обнаружение языка, маршрутизацию URL, hreflang, "
"метаописания и функции AI для кратких описаний, мета и переводов."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Ули Хаке"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

