msgstr ""
"Не удалось скопировать файл. Проверьте, что папка uploads доступна для "
"записи."

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:225
msgid "Invalid file reference."
msgstr "Недопустимая ссылка на файл."

