#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Лингва Фордж"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Многоязычная маршрутизация, полноценное многоязычное SEO (hreflang, Open "
"Graph, Schema.org, карта сайта), и инструменты AI для контента для "
"WordPress. Обнаружение языка, маршрутизация URL, перевод, создание контента "
"и полноценный SEO-слой — без необходимости дополнительного плагина."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Ули Хаке"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

