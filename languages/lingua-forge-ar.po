#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block title"
msgid "Missing Translation Notice"
msgstr "إشعار الترجمة المفقودة"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block description"
msgid ""
"Renders a polite notice when the current page is being shown in its source "
"language because no translation exists for the visitor's language. Driven by "
"the Lingua Forge router's LINGUAFORGE_LANG_FALLBACK_ACTIVE signal — emits "
"nothing when a translation exists for the request locale."
msgstr ""
"يعرض إشعارًا مؤدبًا عندما يتم عرض الصفحة الحالية بلغتها الأصلية لأنه لا توجد "
"ترجمة للغة الزائر. يقوده إشارة LINGUAFORGE_LANG_FALLBACK_ACTIVE لموجه لينجوا "
"فورج — لا يصدر شيئًا عندما توجد ترجمة للغة الطلب."

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "language"
msgstr "اللغة"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "الترجمة"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "fallback"
msgstr "البديل"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "i18n"
msgstr "i18n"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "linguaforge"
msgstr "لينجوا فورج"
