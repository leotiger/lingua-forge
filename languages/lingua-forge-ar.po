#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "لينجوا فورج"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"توجيه متعدد اللغات، تحسين محركات البحث متعدد اللغات بالكامل (hreflang، Open "
"Graph، Schema.org، خريطة الموقع)، وأدوات محتوى الذكاء الاصطناعي لـ ووردبريس. "
"اكتشاف اللغة، توجيه URL، الترجمة، إنشاء المحتوى، وطبقة SEO كاملة — لا حاجة "
"إلى مكون إضافي مرافق."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "ولي هاك"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

