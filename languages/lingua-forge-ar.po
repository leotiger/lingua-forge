#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "لينجوا فورج"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"التوجيه متعدد اللغات، علامات وصف SEO، وأدوات المحتوى بالذكاء الاصطناعي "
"لووردبريس. يجمع بين اكتشاف اللغة، توجيه URL، hreflang، أوصاف الميتا، وميزات "
"المقتطفات، الميتا، والترجمة المدعومة بالذكاء الاصطناعي."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "ولي هاك"

