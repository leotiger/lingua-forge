msgstr "مرجع مدل‌های موجود"

#: ai/includes/Admin/Settings/Tabs/GeneralTab.php:294
msgid "Model ID"
msgstr "شناسه مدل"

#: ai/includes/Admin/Settings/Tabs/GeneralTab.php:295
