#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "لانگوا فورج"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"مسیر یابی چندزبانه، برچسب‌های متا سئو، و ابزارهای محتوای هوشمند برای وردپرس. "
"ترکیب تشخیص زبان، مسیر یابی URL، hreflang، توضیحات متا، و ویژگی‌های اقتباس، "
"متا، و ترجمه مبتنی بر هوش مصنوعی."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "اولی هاکه"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

