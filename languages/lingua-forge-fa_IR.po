#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:240
msgid "Size"
msgstr "اندازه"

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:176
msgid "Delete all files for this override (both .mo and .po)?"
msgstr "حذف تمام فایل‌های این جایگزینی (هر دو فایل .mo و .po)؟"

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:180
