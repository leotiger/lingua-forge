#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "لانگوا فورج"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"مسیر چندزبانه، سئو کامل چندزبانه (hreflang، Open Graph، Schema.org، نقشه "
"سایت)، و ابزارهای محتوای هوش مصنوعی برای وردپرس. تشخیص زبان، مسیر URL، "
"ترجمه، تولید محتوا، و یک لایه کامل سئو — بدون نیاز به افزونه همراه."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "اولی هاکه"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

