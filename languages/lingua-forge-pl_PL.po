#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Wielojęzyczne routingi, pełne wielojęzyczne SEO (hreflang, Open Graph, "
"Schema.org, mapa strony), oraz narzędzia AI do tworzenia treści dla "
"WordPressa. Wykrywanie języka, routingi URL, tłumaczenia, generowanie treści "
"i pełna warstwa SEO — bez konieczności posiadania dodatkowego wtyczki."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

