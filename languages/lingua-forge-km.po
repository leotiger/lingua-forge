#: ai/includes/Admin/Settings/Panels/SeoAnalysisPanel.php:1039
#, php-format
msgid ""
"%1$d words — very thin content. Consider expanding to at least %2$d words."
msgstr "%1$d ពាក្យ — ខ្លឹមសារស្តើងខ្លាំង។ សូមពិចារណាពង្រីកឱ្យដល់យ៉ាងហោចណាស់ %2$d ពាក្យ។"

