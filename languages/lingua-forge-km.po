msgid ""
"%1$d chars — good, slightly above the ideal %2$d but within the accepted "
"%3$d-char range. %4$s"
msgstr ""
"%1$d តួអក្សរ — ល្អ, ខ្ពស់បន្តិចលើសសមាមាត្រល្អ %2$d ប៉ុន្តែនៅក្នុងជួររបស់ %3$d តួអក្សរ។ %4$s"

#. translators: %1$d: number of characters, %2$s: source note
#: ai/includes/Admin/Settings/Panels/SeoAnalysisPanel.php:1024
#, php-format
