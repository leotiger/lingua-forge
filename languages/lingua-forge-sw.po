#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Njia za lugha nyingi, SEO kamili ya lugha nyingi (hreflang, Open Graph, "
"Schema.org, ramani ya tovuti), na zana za AI za maudhui kwa WordPress. "
"Utambuzi wa lugha, njia za URL, tafsiri, uzalishaji wa maudhui, na safu "
"kamili ya SEO — hakuna programu-jalizi ya msaidizi inayohitajika."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

