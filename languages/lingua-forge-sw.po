#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:198
msgid "Upload .mo file"
msgstr "Pakua faili ya .mo"

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:104
msgid ""
"Upload compiled .mo files to override third-party plugin strings for "
"specific locales — for example, a custom VikBooking translation that uses "
"\"apartment\" instead of \"room\". Files must follow the WordPress naming "
"convention: {textdomain}-{locale}.mo (e.g. vikbooking-ca.mo). They are "
"stored in the uploads folder and survive plugin updates."
msgstr ""
"Pakua faili zilizokusanywa za .mo kubadilisha maneno ya programu za watu "
"wengine kwa maeneo maalum — kwa mfano, tafsiri maalum ya VikBooking "
"inayotumia \"apartment\" badala ya \"room\". Faili lazima zifuate muundo wa "
"jina la WordPress: {textdomain}-{locale}.mo (mfano, vikbooking-ca.mo). Zina "
"hifadhiwa kwenye folda ya uploads na huishi baada ya sasisho la programu."

