#, php-format
msgid ""
"This key is currently supplied by a server %s and cannot be removed here. "
"Enter a new key above to override it with a database value."
msgstr ""
"Funguo hili kwa sasa linatolewa na seva %s na haliwezi kuondolewa hapa. "
"Ingiza funguo mpya juu ili kuilinda na thamani ya hifadhidata."

#: ai/includes/Admin/Settings/Tabs/RouterTab.php:542
msgid "This language is protected and cannot be uninstalled."
msgstr "Lugha hii inalindwa na haiwezi kufutwa."

#: ai/includes/Admin/Settings/Tabs/RouterTab.php:484
