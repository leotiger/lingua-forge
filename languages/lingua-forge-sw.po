#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block title"
msgid "Missing Translation Notice"
msgstr "Arifa ya Tafsiri Iliyokosewa"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block description"
msgid ""
"Renders a polite notice when the current page is being shown in its source "
"language because no translation exists for the visitor's language. Driven by "
"the Lingua Forge router's LINGUAFORGE_LANG_FALLBACK_ACTIVE signal — emits "
"nothing when a translation exists for the request locale."
msgstr ""
"Huonyesha arifa ya heshima wakati ukurasa wa sasa unaonyeshwa kwa lugha yake "
"ya asili kwa sababu hakuna tafsiri inayopo kwa lugha ya mgeni. Inasababishwa "
"na ishara ya LINGUAFORGE_LANG_FALLBACK_ACTIVE ya mtaalamu wa Lingua Forge — "
"haitoi chochote wakati kuna tafsiri kwa eneo la ombi."

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "language"
msgstr "lugha"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "tafsiri"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "fallback"
msgstr "kuzingatia"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "i18n"
msgstr "i18n"

