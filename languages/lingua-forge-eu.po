#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:213
msgid "Loco Translate — Copy to Safe Storage"
msgstr "Loco Translate — Kopiatu Segurtasun Gordailura"

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:214
msgid ""
"Loco Translate stores its custom translations in wp-content/languages/loco/ "
"— a location that can be silently wiped by a WP core update, plugin "
"reinstall, or if Loco Translate itself is removed. Copying files here moves "
"them into the Lingua Forge i18n-overrides directory, which persists through "
"all of those events and is loaded automatically on every request."
msgstr ""
"Loco Translate-k bere itzulpen pertsonalak wp-content/languages/loco/ "
"kokatzen ditu — leku hori WP eguneraketak, plugina berrabiarazteak edo Loco "
"Translate bera ezabatzeak ezabatzen du. Fitxategiak hemen kopiatzeak Lingua "
"Forge i18n-overrides direktorioan jartzen ditu, eta horrek iraun egiten du "
"eta automatikoki kargatzen da eskaera bakoitzean."

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:219
