#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"Baliabide anitzeko bidegurutzeak, SEO meta etiketak, eta AI eduki tresnak "
"WordPress-entzat. Hizkuntza detekzioa, URL bidegurutzeak, hreflang, meta "
"deskribapenak, eta AI-k powered laburpen, meta, eta itzulpen ezaugarriak "
"konbinatzen ditu."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

