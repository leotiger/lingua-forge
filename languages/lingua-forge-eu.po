#: ai/includes/Admin/Settings/Tabs/ApiKeysTab.php:579
msgid "The sample post has no visible text content to translate."
msgstr "Adibide-argitalak ez du itzultzeko testu-eduki ikusgairik."

#: ai/includes/Admin/Settings/Tabs/ApiKeysTab.php:585
