#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block title"
msgid "Missing Translation Notice"
msgstr "Hitzordua falta den oharraren jakinarazpena"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block description"
msgid ""
"Renders a polite notice when the current page is being shown in its source "
"language because no translation exists for the visitor's language. Driven by "
"the Lingua Forge router's LINGUAFORGE_LANG_FALLBACK_ACTIVE signal — emits "
"nothing when a translation exists for the request locale."
msgstr ""
"Uneko orria bere jatorrizko hizkuntzan erakusten du, ez dagoelako itzulpenik "
"bisitariaren hizkuntzarako. Lingua Forge router-aren "
"LINGUAFORGE_LANG_FALLBACK_ACTIVE seinalearen bidez kontrolatzen da — ez du "
"ezer emititzen eskaeraren hizkuntzarako itzulpenik badago."

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "language"
msgstr "hizkuntza"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "translation"
msgstr "itzulpena"

#: language-router/blocks/missing-translation-notice/block.json
msgctxt "block keyword"
msgid "fallback"
msgstr "falta"

