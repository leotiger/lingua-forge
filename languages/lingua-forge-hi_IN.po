#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "लिंगुआ फोर्ज"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"मल्टीभाषी रूटिंग, एसईओ मेटा टैग, और वर्डप्रेस के लिए एआई सामग्री उपकरण। यह "
"भाषा पहचान, URL रूटिंग, hreflang, मेटा विवरण, और एआई-संचालित अंश, मेटा, और "
"अनुवाद सुविधाओं को मिलाता है।"

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "उली हाके"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

