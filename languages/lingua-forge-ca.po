#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Enrutament multilingüe, SEO multilingüe complet (hreflang, Open Graph, "
"Schema.org, sitemap), i eines de contingut AI per a WordPress. Detecció "
"d'idioma, enrutament d'URL, traducció, generació de contingut, i una capa "
"SEO completa — sense necessitat d'un plugin complementari."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

