msgstr "Estat"

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:108
msgid "✓ Active"
msgstr "✓ Actiu"

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:110
msgid "— Not detected"
msgstr "— No detectat"

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:120
msgid ""
"No conflicting SEO plugins detected. Lingua Forge is handling all SEO output "
"independently."
msgstr ""
"No s'han detectat plugins SEO conflictius. Lingua Forge gestiona tota la "
"sortida SEO de manera independent."

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:125
msgid "What LF provides — and collision avoidance"
msgstr "El que proporciona LF — i evitació de col·lisions"

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:130
#: ai/includes/Admin/Settings/Panels/UsageStatsPanel.php:153
#: ai/includes/Core/PrivacyIntegration.php:117
msgid "Feature"
msgstr "Funció"

#: ai/includes/Admin/Settings/Panels/CompatibilityPanel.php:131
