msgid "No response from provider — check the error log for details."
msgstr "没有收到提供者的响应 — 请检查错误日志以获取详细信息。"

#: ai/includes/Admin/SettingsPage.php:226
msgid "Network error — could not reach the WordPress AJAX endpoint."
msgstr "网络错误 — 无法连接到 WordPress AJAX 端点。"

