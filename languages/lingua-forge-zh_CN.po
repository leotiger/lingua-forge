msgid "Meta Description, Excerpt Generator"
msgstr "元描述、摘要生成器"

#: ai/includes/Admin/SettingsPage.php:93
msgid "Translation, Content Generator"
msgstr "翻译、内容生成"

#: ai/includes/Admin/SettingsPage.php:222
msgid "Testing…"
msgstr "测试中…"

#: ai/includes/Admin/SettingsPage.php:223
msgid "✓ Connection OK"
msgstr "✓ 连接正常"

#: ai/includes/Admin/SettingsPage.php:224
msgid "✗ Failed:"
msgstr "✗ 失败："

