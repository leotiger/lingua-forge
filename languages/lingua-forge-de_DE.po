#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Mehrsprachiges Routing, vollständiges mehrsprachiges SEO (hreflang, Open "
"Graph, Schema.org, Sitemap) und KI-Inhaltstools für WordPress. "
"Spracherkennung, URL-Routing, Übersetzung, Inhaltserstellung und eine "
"vollständige SEO-Schicht — kein Begleit-Plugin erforderlich."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

