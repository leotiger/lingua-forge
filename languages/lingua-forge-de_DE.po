#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"Mehrsprachiges Routing, SEO-Meta-Tags und KI-Inhaltstools für WordPress. "
"Kombiniert Spracherkennung, URL-Routing, hreflang, Meta-Beschreibungen sowie "
"KI-gestützte Auszüge, Meta- und Übersetzungsfunktionen."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

