msgstr[0] "✓ Actief — %d URL-vermelding met taalalternatieven"
msgstr[1] "✓ Actief — %d URL-vermeldingen met taalalternatieven"

#: ai/includes/Admin/Settings/Panels/SitemapPanel.php:153
