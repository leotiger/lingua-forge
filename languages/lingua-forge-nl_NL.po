#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:207
msgid "Lingua Forge"
msgstr "Lingua Forge"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, complete multilingual SEO (hreflang, Open Graph, "
"Schema.org, sitemap), and AI content tools for WordPress. Language "
"detection, URL routing, translation, content generation, and a full SEO "
"layer — no companion plugin required."
msgstr ""
"Meertalige routing, volledige meertalige SEO (hreflang, Open Graph, Schema."
"org, sitemap), en AI-inhoudtools voor WordPress. Taalherkenning, URL-"
"routing, vertaling, inhoudgeneratie, en een volledige SEO-laag — geen "
"bijbehorende plugin nodig."

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

