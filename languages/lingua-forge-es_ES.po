msgstr "Salida del esquema JSON-LD de Schema.org en wp_head"

#: ai/includes/Admin/Settings/Panels/SchemaPanel.php:102
msgid "Locked — a conflicting SEO plugin is active. See the notice above."
msgstr ""
"Bloqueado — hay un plugin de SEO en conflicto activo. Consulta el aviso "
"anterior."

#: ai/includes/Admin/Settings/Panels/SchemaPanel.php:110
msgid "Article / WebPage"
msgstr "Artículo / Página Web"

