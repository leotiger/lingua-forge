msgid "WordPress AI Client (WP 7.0+)"
msgstr "Πελάτης AI του WordPress (WP 7.0+)"

#: ai/includes/Admin/SettingsPage.php:89
msgid "Meta Description, Excerpt Generator"
msgstr "Μετα-περιγραφή, Δημιουργός περίληψης"

#: ai/includes/Admin/SettingsPage.php:93
msgid "Translation, Content Generator"
msgstr "Μετάφραση, Δημιουργός Περιεχομένου"

