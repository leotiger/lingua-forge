#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:237
msgid "Text domain / locale"
msgstr "Τομέας / τοπική ρύθμιση"

#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:156
#: ai/includes/Admin/Settings/Panels/LanguageOverridesPanel.php:240
