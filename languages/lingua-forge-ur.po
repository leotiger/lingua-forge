"Language installation is disabled on this server (DISALLOW_FILE_MODS is set)."
msgstr "اس سرور پر زبان کی تنصیب غیر فعال ہے (DISALLOW_FILE_MODS سیٹ ہے)۔"

#: ai/includes/Admin/Settings/Tabs/RouterTab.php:804
msgid "Invalid locale code."
msgstr "غلط لوکیل کوڈ۔"

#. translators: %s: locale code such as de_DE
