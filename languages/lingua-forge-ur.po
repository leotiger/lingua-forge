#. Plugin Name of the plugin
#: lingua-forge.php ai/assets/toolbar-translate.js:197
msgid "Lingua Forge"
msgstr "لینگوا فورج"

#. Plugin URI of the plugin
#: lingua-forge.php
msgid "https://github.com/leotiger/lingua-forge"
msgstr "https://github.com/leotiger/lingua-forge"

#. Description of the plugin
#: lingua-forge.php
msgid ""
"Multilingual routing, SEO meta tags, and AI content tools for WordPress. "
"Combines language detection, URL routing, hreflang, meta descriptions, and "
"AI-powered excerpt, meta, and translation features."
msgstr ""
"ملٹی لسانی راستہ بندی، SEO میٹا ٹیگز، اور AI مواد کے اوزار ورڈپریس کے لیے۔ "
"زبان کا پتہ لگانے، URL راستہ بندی، hreflang، میٹا تفصیلات، اور AI سے چلنے "
"والی اقتباس، میٹا، اور ترجمہ کی خصوصیات کو یکجا کرتا ہے۔"

#. Author of the plugin
#: lingua-forge.php
msgid "Uli Hake"
msgstr "Uli Hake"

#. Author URI of the plugin
#: lingua-forge.php
msgid "https://lingua-forge.com"
msgstr "https://lingua-forge.com"

