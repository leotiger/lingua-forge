msgid "Minimum role"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:109
msgid "Lowest WordPress capability allowed to trigger AI features. Tightening this on multi-author sites prevents Contributors or trial accounts from running paid AI calls. Override per-feature via the linguaforge_required_capability filter."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:118
msgid "Translation Limits"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:122
msgid "Control how much content is sent to the AI and how large the response can be. Leave a field blank to use the built-in default (shown as placeholder). Raise these values if large pages are being cut off; lower them to reduce API costs."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:131
#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:225
msgid "Model tier"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:143
msgid "Quality (default — Sonnet / GPT-4o / Gemini Pro)"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:146
msgid "Light (fast and cost-effective — Haiku / Flash)"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:151
msgid "Which model tier to use for full-page translation. Quality uses the model configured in the Models table above and is recommended for accurate, long-form translation. Switch to Light only if speed or cost is the priority and the content is short."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:160
#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:254
#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:315
msgid "Max output tokens"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/LimitsTab.php:177
