#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:29
msgid "Block Editor"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:33
msgid "Lingua Forge restricts two Gutenberg features by default to keep editorial behavior consistent across languages. Opt in here when you need full Gutenberg / FSE capabilities."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:40
msgid "Block locking"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:50
msgid "Allow editors to lock individual blocks"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:53
msgid "Re-enables Gutenberg's canLockBlocks. Useful for editorial templates that need to prevent contributors from moving or deleting specific blocks."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:59
msgid "Template mode"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:69
msgid "Allow Gutenberg template-editing mode on post screens"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:72
msgid "Re-enables supportsTemplateMode. Core to Full-Site-Editing workflows where post-level template overrides are intentional."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:79
msgid "Compliance Preset"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:83
msgid "Strict-preservation mode for legal, regulatory, medical, or technical content. When on, every AI feature uses a low sampling temperature and appends the addendum below to its system prompt — terminology, article numbers, units, brand names, and regulatory language are preserved verbatim rather than paraphrased."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:91
msgid "Global AI preset"
msgstr ""

#. translators: %s: sampling temperature value, e.g. 0.2
#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:106
#, php-format
msgid "T=%s"
msgstr ""

#. translators: temperature range shown for the Standard preset, e.g. "T=0.2–0.6, per feature"
#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:111
msgid "T=0.2–0.6, per feature"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:118
msgid "Sets the default AI behaviour for all features site-wide. Individual posts can override this for Translation and Content Generation via the Lingua Forge meta box."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:119
msgid "Standard uses each feature's own tuned temperature: Translation T=0.2 (precise), Quick Translate T=0.4, Content Generator T=0.6 (creative). The other presets apply a single fixed temperature across all features."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:129
msgid "Technical / Scientific instructions"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:130
msgid "Legal / Compliance instructions"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:131
msgid "Creative / Marketing instructions"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:154
msgid "Leave blank to use the built-in default. Clearing a saved override restores the default on next save."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:157
msgid "View built-in default"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:166
#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:177
#: ai/includes/Admin/Settings/Tabs/MaintenanceTab.php:418
msgid "Translation Memory"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:170
msgid "Cache translated equivalents at the block level so reusable content (shared footers, sidebars, accordions, boilerplate-heavy legal sections) does not pay an API call every time. When enabled, the translation flow parses each post into blocks, looks each block up in the cache, and sends only uncached blocks to the AI in a single batched request. Glossary edits and Compliance preset changes automatically invalidate affected cached translations. View statistics and clear the cache under Maintenance."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:187
msgid "Enable block-level translation cache reuse across posts"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:190
msgid "Currently skipped for posts that use block-comment attribute placeholders (wp:details summary fields, etc.) — they fall through to the existing single-call translation path."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:197
#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:208
#: ai/includes/Admin/Settings/Tabs/MaintenanceTab.php:415
msgid "API Response Cache"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:201
msgid "The API Response Cache stores the raw result of every AI request — translation, meta description, excerpt, and content generation — keyed by a hash of the inputs (content, language pair, provider, model). Subsequent requests with identical inputs are served from the cache with no API call. The cache is different from Translation Memory: Translation Memory operates at the block level and is shared across posts; the API Response Cache operates at the feature level and is keyed per post."
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:218
msgid "Enable API response caching"
msgstr ""

#: ai/includes/Admin/Settings/Tabs/BehaviorTab.php:221
msgid "Disable during prompt tuning or when you need every request to reach the AI provider. Disabling does not delete cached entries — re-enabling restores them. Increasing API spend immediately on busy sites is expected when disabled."
msgstr ""

